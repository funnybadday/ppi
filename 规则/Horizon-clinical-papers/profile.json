        "tools": ["web_search"],
        "optional": true
      },
      {
        "id": "evidence",
        "type": "section",
        "tools": ["web_search"]
      },
      {
        "id": "impact",
        "type": "section",
        "tools": ["web_search"],
        "optional": true
      }
    ]
  }
