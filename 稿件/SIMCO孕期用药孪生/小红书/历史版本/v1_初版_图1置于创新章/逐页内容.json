    "fragments": [
      {
        "source_block_index": 7,
        "type": "paragraph",
        "start": 0,
        "end": 98,
        "page": 4,
        "text": "在扰动图谱内的四折交叉验证中，SIMCO的单细胞模拟在MAE、R2、MMD三项指标上均优于两个基线，模拟误差与患者间真实变异的相关达Spearman R=0.93，验证设计见论文Figure 4。",
        "line_tops": [
          340.89,
          408.89,
          476.89,
          544.89
        ]
      }
    ],
    "image_blocks": [
      6
    ],
    "source_visible": false
  },
